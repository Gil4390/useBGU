MLM ABCD

  model AB
    class A
      attributes
        a1: String
        a2: String
    end

    class B
      attributes
        b1: Integer
        b2: String
    end

    association ab1 between
      A[*] role aa1
      B[*] role bb1
    end

    constraints
    context A
      inv i1:
        self.bb1->forAll( it | it.b1 > 5)


  model CD
    class C
      attributes
        c: String
    end

    class D
      attributes
        d: String
    end

    association cd1 between
      C[*] role cc1
      D[*] role dd1
    end


mediator AB < NONE
end

mediator CD < AB
    clabject C : A
        constraints
            ~i1
    end

    clabject D : B
    end

end
