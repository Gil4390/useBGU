MLM CD

  model M1
    class A
    end

    class B
    end


    association assoc1 between
      A[*] role aa1
      B[*] role bb1
    end


  model M2
    class C
    end

    class D
    end

    association assoc2 between
      C[*] role cc1
      D[*] role dd1
    end

  model M3
    class E
    end

    class F
    end

    association assoc3 between
      E[*] role ee1
      F[*] role ff1
    end


mediator M1 < NONE
end

mediator M2 < M1
  clabject C : A
    roles
        ~bb1
  end

  clabject D : B
  end
end

mediator M3 < M2
  clabject E : C
    roles
        ~dd1
  end

  clabject F : D
    roles
        ~cc1
        ~aa1
  end
end

