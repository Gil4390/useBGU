MLM CD

  model M1
    class D
      attributes
        attr1: Integer
    end

    constraints
    context D
      inv i1:
        self.attr1 > 5


  model M2
    class C
      attributes
        attr2: String
    end


mediator M1 < NONE
end

mediator M2 < M1
  clabject C : D
    attributes
        ~attr1
  end

end

