MLM RoleDiamond

  model M1
    class D
    end

    class G
    end

    class E < D
    end

    association assoc1 between
      D[*] role dd1
      G[*] role gg1
    end


  model M2
    class C
    end

    class F < C
    end


mediator M1 < NONE
end

mediator M2 < M1
  clabject C : D
  end

  clabject F : E
  end

end
