MLM CD

  model M1
    class A
    end

    class B
    end


    association assoc1 between
      A[*] role aa1
      B[*] role bb1
    end


  model M2
    class C
    end

    class D
    end

    association assoc2 between
      C[*] role cc1
      D[*] role dd1
    end

  model M3
    class E
    end

    class F
    end

    association assoc3 between
      E[*] role ee1
      F[*] role ff1
    end


mediator M1 < NONE
end

mediator M2 < M1
  clabject C : A
  end

  clabject D : B
  end

  assoclink assoc2 : assoc1
        aa1 -> cc1
        bb1 -> dd1
  end

end

mediator M3 < M2
  clabject E : C
  end

  clabject F : D
  end

  assoclink assoc3 : assoc2
        cc1 -> ee1
        dd1 -> ff1
  end

end

