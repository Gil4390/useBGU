MLM ABCD

  model AB
    class A
    end

    class B
    end

    class X
    attributes
      x1: Integer
    end

    association ab1 between
      A[1] role aa1
      B[1] role bb1
    end

    association bx1 between
          B[1] role bb2
          X[1] role xx1
        end

    constraints
    context A
      inv i1:
        self.bb1.xx1.x1 > 5


  model CD
    class C
    end

    class D
    end

    association cd1 between
      C[1] role cc1
      D[1] role dd1
    end


mediator AB < NONE
end

mediator CD < AB

    clabject D : B
        roles
            ~xx1
    end

end
