MLM CD

  model M1
    class D
    end

    class E
    end

    association assoc1 between
      D[*] role dd1
      E[*] role r
    end


  model M2
    class C
    end

    class F
    end

    association assoc2 between
      C[*] role cc1
      F[*] role r
    end


mediator M1 < NONE
end

mediator M2 < M1
  clabject C : D
  end

  clabject F : E
  end

  assoclink assoc2 : assoc1
    cc1 -> dd1
    r -> r
  end

end

