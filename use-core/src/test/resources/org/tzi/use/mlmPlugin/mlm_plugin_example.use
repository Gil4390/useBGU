MLM ABCD

  model AB
    class A
      attributes
        a1: String
        a2: Integer
    end

    class B
      attributes
        b1: String
        b2: Integer
    end

    association ab1 between
      A[1] role aa1
      B[1] role bb1
    end

--    constraints
--    context A
--        inv a1:
--            self.bb1->select(b | b.b2 > 5)->size() > 0


  model CD
    class C
      attributes
        c: String
    end

    class D
      attributes
        d: String
    end

    class E
    end

    association cd1 between
      C[1] role cc1
      D[1] role dd1
    end

    --association cd2 between
    --  C[1] role cc2
    --  E[1] role ee1
    --end

    --association cd3 between
      --E[2] role ee2
      --D[1] role dd2
    --end

--inter-constraints
--context CD@C
--  inv i1:
--    self.a2 > 5
--  inv i2:
--    self.bbb1->select(b | b.b2 > 5)->size() > 0


mediator AB < NONE
end

mediator CD < AB
    clabject C : A
    end

    clabject D : B
    end

    assoclink cd1 : ab1
        cc1 -> aa1
        dd1 -> bb1
    end
end
