MLM ABCD

  model AB
    class A
    end

    class B
    end

    association ab1 between
      A[1] role aa1
      B[1] role bb1
    end


  model CD
    class C
    end

    class D
    end


    association cd1 between
      C[1] role cc1
      D[1] role dd1
    end


mediator AB < NONE
end

mediator CD < AB
    clabject C : A
    end

    clabject D : B
    end

    -- adding an assoclink suppose to make the model satisfiable, but it is not
    --assoclink cd1 : ab1
      --  cc1 -> aa1
      --  dd1 -> bb1
    --end
end
