MLM ABCD

  model AB
    class A
    end

    class B
    end

    association ab1 between
      A[1] role aa1
      B[1] role bb1
    end


  model CD
    class C
    end

    class D
    end

    association cd1 between
      C[1] role cc1
      D[1] role dd1
    end

mediator AB < NONE
end

mediator CD < AB
-- plugin satisfiable only when the number of objects of 'A' and 'B' is 0.
    clabject C : A
    roles
        ~bb1
    end

    clabject D : B
    end

end
