MLM ABCD

  model AB
    class A
      attributes
        a1: String
        a2: Integer
    end

    constraints
    context A
      inv i1:
        self.a2 > 5


  model CD
    class C
      attributes
        c: String
    end


mediator AB < NONE
end

mediator CD < AB
    clabject C : A
    attributes
      ~a2
    constraints
      ~i1
    end

end
