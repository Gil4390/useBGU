MLM ABCD

  model AB
    class A
    end

    class B
    end

    association ab1 between
      A[*] role aa1
      B[*] role bb1
    end


  model CD
    class C
    end

    class D
    end

    association cd1 between
      C[*] role cc1
      D[*] role dd1
    end


mediator AB < NONE
end

mediator CD < AB
    clabject C : A
    end

    clabject D : B
    end

    assoclink cd1 : ab1
        aa1 -> cc1
        bb1 -> dd1
    end

end
