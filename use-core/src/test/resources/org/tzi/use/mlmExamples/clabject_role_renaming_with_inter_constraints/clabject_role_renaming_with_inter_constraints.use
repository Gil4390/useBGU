MLM ABCD

  model AB
    class A
    end

    class B
      attributes
        b1: String
    end

    association ab1 between
      A[*] role aa1
      B[*] role bb1
    end


  model CD
    class C
    end

    class D
    end

    association cd1 between
      C[*] role cc1
      D[*] role dd1
    end


inter-constraints
context CD@C
  inv i1:
    self.bb5->forAll( b | b.b1 = 'b')


mediator AB < NONE
end

mediator CD < AB
  clabject C : A
    roles
      bb1 -> bb5
  end

  clabject D : B
  end

end

