MLM ABCD

  model AB
    class A
    end

    class B
    end

    association ab1 between
      A[1] role aa1
      B[2] role bb1
    end


  model CD
    class C
    end

    class D
    end

    class E
    end

    association cd1 between
      C[*] role cc1
      D[*] role dd1
    end
    association ce1 between
      C[*] role cc1
      E[*] role ee1
    end


mediator AB < NONE
end

mediator CD < AB
    clabject C : A
    end

    clabject D : B
    end

    clabject E : B
    end

    assoclink cd1 : ab1
        aa1 -> cc1
        bb1 -> dd1
    end

    assoclink ce1 : ab1
       aa1 -> cc1
       bb1 -> ee1
    end
end
